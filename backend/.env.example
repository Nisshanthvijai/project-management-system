# PostgreSQL connection string (Neon / Supabase / local)
DATABASE_URL="postgresql://user:password@localhost:5432/pm_db?schema=public"
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
# Comma-separated list of allowed web origins (no trailing slash)
CORS_ORIGINS="http://localhost:5173"
PORT=4000
NODE_ENV=development
